# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                    # from Developers > Webhooks after you add the endpoint
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...

# Your deployed domain (used to build Stripe success/cancel URLs)
NEXT_PUBLIC_SITE_URL=https://www.yourgofitdomain.com

# M-Pesa (Safaricom Daraja API) — developer.safaricom.co.ke
MPESA_ENV=sandbox                                  # 'sandbox' while testing, 'production' when live
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=your-paybill-or-till-number        # 174379 is Safaricom's shared sandbox shortcode
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_SECRET=make-up-any-long-random-string   # protects your callback URL from strangers
